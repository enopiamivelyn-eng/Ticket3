SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional Next.js browser aliases for Realtime; use the same project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side Prisma connection. For Vercel/serverless, copy the Transaction Pooler
# URI from Supabase Dashboard > Connect (port 6543), then append these parameters.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
